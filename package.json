{
  "name": "heediq-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/local.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pre-pr": "pnpm run typecheck && pnpm run test",
    "test:integration": "tsx scripts/integration/create-tables.ts && vitest run --config vitest.integration.config.ts",
    "e2e:full-loop": "node tests/e2e/full-loop-smoke.mjs",
    "docker:integration:up": "docker compose -f docker-compose.integration.yml up -d",
    "docker:integration:down": "docker compose -f docker-compose.integration.yml down",
    "bundle": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js --external:@aws-sdk/*",
    "bundle:auth-provision": "esbuild src/handlers/auth-provision.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/auth-provision.js --external:@aws-sdk/*",
    "bundle:auth-trigger-pre-signup": "esbuild src/handlers/auth-trigger-pre-signup.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/auth-trigger-pre-signup.js --external:@aws-sdk/*",
    "bundle:auth-trigger-post-confirmation": "esbuild src/handlers/auth-trigger-post-confirmation.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/auth-trigger-post-confirmation.js --external:@aws-sdk/*",
    "bundle:auth-trigger-post-authentication": "esbuild src/handlers/auth-trigger-post-authentication.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/auth-trigger-post-authentication.js --external:@aws-sdk/*",
    "bundle:ws-connect": "esbuild src/handlers/ws-connect.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/ws-connect.js --external:@aws-sdk/*",
    "bundle:ws-pusher": "esbuild src/handlers/ws-pusher.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/ws-pusher.js --external:@aws-sdk/*",
    "bundle:classification-pusher": "esbuild src/handlers/classification-pusher.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/classification-pusher.js --external:@aws-sdk/*"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1086.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1079.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.996.5",
    "@amplitude/analytics-node": "^1.3.6",
    "@heediq/shared": "^0.15.6",
    "@hono/node-server": "^2.0.6",
    "hono": "^4.5.0",
    "jose": "^5.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.143",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
